# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Default LLM backend (Anthropic). Required for generating new HyDE documents,
# answers and judgements. NOT required to reproduce BEIR retrieval results:
# cached hypothetical documents are committed under cache/beir/.
ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible backend for open-weights models ("private deployment" mode).
# Groq:   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# Ollama: OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1   (key can be any non-empty string)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Optional: openFDA API key (raises rate limits for the food recall download script).
OPENFDA_API_KEY=

# Hard stop for any bulk LLM run whose estimated cost exceeds this (USD).
HYDE_RAG_COST_LIMIT_USD=5
