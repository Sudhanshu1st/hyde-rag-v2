# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Everything in this project runs at zero cost.

# Groq free plan key (https://console.groq.com, no payment method needed).
# Only required to generate NEW hypothetical documents, answers or judgements.
# Reproducing the published results needs no key: generations are cached under cache/.
GROQ_API_KEY=

# Optional: any other OpenAI-compatible endpoint instead of Groq, e.g. local Ollama:
#   OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPAT_API_KEY=ollama
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Bulk runs longer than this many days of a model's free quota ask for --yes first.
HYDE_RAG_MAX_QUOTA_DAYS=1

# Safety: the client refuses keys whose rate limits look like a paid plan.
# Leave unset unless you deliberately want to use a paid plan.
# HYDE_RAG_ALLOW_PAID=1
