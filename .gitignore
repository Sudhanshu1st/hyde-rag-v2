# --- secrets: only .env.example is ever committed ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

